{
    "version": 1,

    "formatters":{
        "standard": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },
        "json":{
            "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
            "format": "%(asctime)s %(levelname)s %(name)s %(module)s %(lineno)d %(message)s",
            "rename_fields":{
                "asctime": "timestamp"
            },
            "static_fields":{
                "service": "ext://logging_config.PROJECT_NAME",
                "env": "ext://logging_config.ENVIRONMENT",
                "version": "ext://logging_config.PROJECT_VERSION",
                "app_log": "True"
            }
        }
    },

    "handlers": {
        "console":{
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "level": "INFO"
        },
        "email": {
            "class": "logging.handlers.SMTPHandler",
            "level": "WARNING",
            "formatter": "standard",
            "mailhost": ["smtp.gmail.com", 587],
            "fromaddr": "ext://os.environ.get('EMAIL_USER')",
            "toaddrs": ["ext://os.environ.get('EMAIL_RECIPIENT')"],
            "subject": "Chillbot Log Alert",
            "credentials": ["ext://os.environ.get('EMAIL_USER')", "ext://os.environ.get('EMAIL_PASSWORD')"],
            "secure": []
        },
        "telegram_file":{
            "class": "logging.FileHandler",
            "formatter": "json",
            "filename": "telegram_monitor.log",
            "level": "WARNING"
        },
        "wallet_file":{
            "class": "logging.FileHandler",
            "formatter": "json",
            "filename": "wallet.log",
            "level": "WARNING"
        },
        "trader_file":{
            "class": "logging.FileHandler",
            "formatter": "json",
            "filename": "trader.log",
            "level": "WARNING"
        }
    },

    "loggers": {
        "":{
            "handlers": ["console", "email"],
            "level": "INFO",
            "propagate": "True"
        },
        "utils":{
            "handlers": ["console"],
            "level": "INFO",
            "propagate": "False"
        },
        "trader":{
            "handlers": ["console", "trader_file"],
            "level": "INFO",
            "propagate": "False"
        },
        "telegram_monitor":{
            "handlers": ["console", "telegram_file"],
            "level": "INFO",
            "propagate": "False"
        },
        "wallet":{
            "handlers": ["console", "wallet_file"],
            "level": "INFO",
            "propagate": "False"
        }
    }
}